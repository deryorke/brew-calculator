# Netlify and Cloudflare Pages read this file; GitHub Pages ignores it (the service worker handles that case).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/icons/*
  Cache-Control: public, max-age=86400
/screenshots/*
  Cache-Control: public, max-age=86400
